Description: Fix path traversal vulnerability in varLib
 The fonttools varLib script had an arbitrary file write vulnerability
 that could lead to remote code execution when processing a malicious
 .designspace file. This patch uses os.path.basename() to prevent
 path traversal attacks.
Author: Cosimo Lupo <clupo@google.com>
Origin: upstream, https://github.com/fonttools/fonttools/commit/a696d5ba93270d5954f98e7cab5ddca8a02c1e32
Bug: https://security-tracker.debian.org/tracker/CVE-2025-66034
Bug-Debian: https://bugs.debian.org/1121605
Forwarded: not-needed
---
 Lib/fontTools/varLib/__init__.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

--- a/Lib/fontTools/varLib/__init__.py
+++ b/Lib/fontTools/varLib/__init__.py
@@ -1456,7 +1456,11 @@ def main(args=None):
         vf_name_to_output_path[vfs_to_build[0].name] = options.outfile
     else:
         for vf in vfs_to_build:
-            filename = vf.filename if vf.filename is not None else vf.name + ".{ext}"
+            if vf.filename is not None:
+                # Only use basename to prevent path traversal attacks
+                filename = os.path.basename(vf.filename)
+            else:
+                filename = vf.name + ".{ext}"
             vf_name_to_output_path[vf.name] = os.path.join(output_dir, filename)
 
     finder = MasterFinder(options.master_finder)
